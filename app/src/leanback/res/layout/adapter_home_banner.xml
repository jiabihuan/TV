<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="320dp">

    <!-- Left Column: stacked navigation buttons -->
    <LinearLayout
        android:id="@+id/leftLayout"
        android:orientation="vertical"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="12dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnVod"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:foreground="@drawable/selector_vod"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_home_vod"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnVodImg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_home_vod"
                    android:tint="@color/white"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/btnVodTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_vod" />
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="6sp"
                        android:textColor="@color/white_70"
                        android:id="@+id/btnVodBrief"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnLive"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:foreground="@drawable/selector_vod"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_home_live"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnLiveImg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_home_live"
                    android:tint="@color/white"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/btnLiveTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_live" />
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="6sp"
                        android:textColor="@color/white_70"
                        android:id="@+id/btnLiveBrief"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnKeep"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:foreground="@drawable/selector_vod"
            android:layout_weight="1"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_home_local"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnKeepImg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_home_keep"
                    android:tint="@color/white"
                    android:layout_marginEnd="8dp" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/btnKeepTxt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_keep" />
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="6sp"
                        android:textColor="@color/white_70"
                        android:id="@+id/btnKeepBrief"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Middle Column: featured detail card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/middleCard"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:foreground="@drawable/selector_vod"
        android:layout_marginEnd="12dp"
        app:cardBackgroundColor="@color/black_50"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/detailLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/middleImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <View
                    android:background="@drawable/shape_banner_shadow"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <LinearLayout
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="marquee"
                        android:id="@+id/middleName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true" />
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="12sp"
                        android:textColor="@color/white_70"
                        android:ellipsize="end"
                        android:id="@+id/middleDirector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:singleLine="true" />
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="12sp"
                        android:textColor="@color/white_70"
                        android:ellipsize="end"
                        android:id="@+id/middleActor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:singleLine="true" />
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="12sp"
                        android:textColor="@color/white_70"
                        android:ellipsize="end"
                        android:id="@+id/middleContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2" />
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/playButtonLayout"
                        android:background="@drawable/shape_play_button_bg"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <FrameLayout
                            android:background="@drawable/shape_white_circle"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:layout_width="22dp"
                            android:layout_height="22dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_gravity="center"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_widget_play"
                                app:tint="@color/black" />
                        </FrameLayout>
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/play"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/indicatorLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/livePreviewLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.cardview.widget.CardView
                    android:id="@+id/previewCard"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">
                    <androidx.media3.ui.PlayerView
                        android:id="@+id/previewExo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:resize_mode="zoom"
                        app:surface_type="texture_view"
                        style="@style/Player.Live" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Right Column: recommendation cards -->
    <FrameLayout
        android:id="@+id/rightLayout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="206dp"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/recommendLayout"
            android:visibility="visible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/card1"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="8dp"
                android:foreground="@drawable/selector_vod"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/black_50"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/recommend_image1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                    <View
                        android:background="@drawable/shape_right_card_shadow"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <LinearLayout
                        android:layout_gravity="start|center"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:ellipsize="end"
                            android:id="@+id/recommend_text1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true" />
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/shape_play_button_bg"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="8dp">
                            <FrameLayout
                                android:background="@drawable/shape_white_circle"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:layout_width="10dp"
                                android:layout_height="10dp">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:src="@drawable/ic_widget_play"
                                    app:tint="@color/black" />
                            </FrameLayout>
                            <com.google.android.material.textview.MaterialTextView
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/play"
                                android:layout_marginStart="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="6sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_gravity="end|bottom|center"
                        android:background="@drawable/shape_recommend_tag_bg"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/home_recommend_tag"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginEnd="4dp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card2"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:foreground="@drawable/selector_vod"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/black_50"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/recommend_image2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                    <View
                        android:background="@drawable/shape_right_card_shadow"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <LinearLayout
                        android:layout_gravity="start|center"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:ellipsize="end"
                            android:id="@+id/recommend_text2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true" />
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/shape_play_button_bg"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="8dp">
                            <FrameLayout
                                android:background="@drawable/shape_white_circle"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:layout_width="10dp"
                                android:layout_height="10dp">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:src="@drawable/ic_widget_play"
                                    app:tint="@color/black" />
                            </FrameLayout>
                            <com.google.android.material.textview.MaterialTextView
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/play"
                                android:layout_marginStart="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="6sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_gravity="end|bottom|center"
                        android:background="@drawable/shape_recommend_tag_bg"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/home_recommend_tag"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginEnd="4dp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card3"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:foreground="@drawable/selector_vod"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/black_50"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/recommend_image3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                    <View
                        android:background="@drawable/shape_right_card_shadow"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <LinearLayout
                        android:layout_gravity="start|center"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:ellipsize="end"
                            android:id="@+id/recommend_text3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true" />
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:background="@drawable/shape_play_button_bg"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginTop="4dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="8dp">
                            <FrameLayout
                                android:background="@drawable/shape_white_circle"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:layout_width="10dp"
                                android:layout_height="10dp">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_gravity="center"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:src="@drawable/ic_widget_play"
                                    app:tint="@color/black" />
                            </FrameLayout>
                            <com.google.android.material.textview.MaterialTextView
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/play"
                                android:layout_marginStart="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.textview.MaterialTextView
                        android:textSize="6sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_gravity="end|bottom|center"
                        android:background="@drawable/shape_recommend_tag_bg"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/home_recommend_tag"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginEnd="4dp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
