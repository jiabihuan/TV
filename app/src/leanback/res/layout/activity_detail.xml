<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_0"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/page_margin"
    android:paddingEnd="@dimen/page_margin">

    <!-- ===================== 上半区：左右对半拆分 ===================== -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/space_lg">

        <!-- 左侧：矩形圆角视频预览窗口 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_weight="1"
            android:background="@drawable/bg_detail_preview"
            android:clipChildren="false"
            android:clipToOutline="true">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Tv.DetailBackdrop" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/previewExo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                style="@style/Player.Live" />

            <!-- 窗口底部：当前集数名称 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/currentEp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:ellipsize="end"
                android:maxWidth="360dp"
                android:singleLine="true"
                android:shadowColor="@color/black"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/detail_current_ep"
                android:textAppearance="@style/TextAppearance.Tv.Label"
                android:textColor="@color/white" />

            <!-- 窗口右下角：半透明全屏播放按钮 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/cardHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_md"
                android:background="@drawable/bg_detail_card_hint"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingEnd="@dimen/space_md"
                android:paddingBottom="@dimen/space_sm"
                android:text="OK 全屏播放"
                android:textColor="@color/text_secondary"
                android:textSize="28sp" />
        </FrameLayout>

        <!-- 右侧：影视信息列 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg">

            <!-- ① 超大书法艺术字体：影视名称 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="720dp"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Tv.Display" />

            <!-- ② 小字标签栏：年份 / 地区 / 类型 / 更新状态 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/metaRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tagYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Tv.Label.Secondary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tagArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:textAppearance="@style/TextAppearance.Tv.Label.Secondary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tagType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:textAppearance="@style/TextAppearance.Tv.Label.Secondary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tagStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:textAppearance="@style/TextAppearance.Tv.Label.Secondary"
                    android:textColor="@color/accent_bright" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ③ 大段剧情简介（自动换行） -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:ellipsize="end"
                android:maxWidth="720dp"
                android:maxLines="4"
                android:textAppearance="@style/TextAppearance.Tv.Body.Secondary" />

            <!-- ④ 当前选中线路 + 集数编号 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/episodeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:textAppearance="@style/TextAppearance.Tv.Label"
                android:textColor="@color/accent_bright" />

            <!-- ⑤ 横向进度条：当前时间 / 总时长 -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="@dimen/space_md"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_resume" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00 / 00:00"
                    android:textAppearance="@style/TextAppearance.Tv.Numeric.Caption"
                    android:textColor="@color/text_tertiary" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- ===================== 下半区：全屏通栏，上下两行 ===================== -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_detail_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_lg">

        <!-- 第一行：播放线路行 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/flagSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_flag"
                android:textAppearance="@style/TextAppearance.Tv.Label"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/flagCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:text="@string/detail_flag_count"
                android:textAppearance="@style/TextAppearance.Tv.Label.Secondary"
                android:textSize="@dimen/text_body" />

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/flag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xl"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 第二行：剧集选集行 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/episodeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_episode"
                    android:textAppearance="@style/TextAppearance.Tv.Label"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/episodeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/detail_episode_count"
                    android:textAppearance="@style/TextAppearance.Tv.Label.Secondary"
                    android:textSize="@dimen/text_body" />

                <!-- 倒序 / 左右翻页箭头 / 集数区间 -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/array"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/reverse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_md"
                        android:background="@drawable/selector_item"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_lg"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_lg"
                        android:paddingBottom="@dimen/space_sm"
                        android:text="@string/play_reverse"
                        android:textAppearance="@style/TextAppearance.Tv.Label"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/pagePrev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:background="@drawable/selector_item"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_sm"
                        android:text="‹"
                        android:textAppearance="@style/TextAppearance.Tv.Label"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/pageNext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_md"
                        android:background="@drawable/selector_item"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/space_md"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingEnd="@dimen/space_md"
                        android:paddingBottom="@dimen/space_sm"
                        android:text="›"
                        android:textAppearance="@style/TextAppearance.Tv.Label"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/arrayInterval"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1-20"
                        android:textAppearance="@style/TextAppearance.Tv.Label.Secondary"
                        android:textColor="@color/text_secondary" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.appcompat.widget.LinearLayoutCompat>
