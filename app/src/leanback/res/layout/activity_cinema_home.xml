<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tv_cinema"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 右侧封面背景 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/coverBg"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center"
        android:alpha="0.82"
        android:scaleType="centerCrop"
        android:visibility="invisible" />

    <!-- 封面遮罩 -->
    <View
        android:id="@+id/coverTint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_tv_cinema_cover_tint" />

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="74dp"
        android:background="#12ffffff" />

    <!-- 顶部导航栏 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="34dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/logo"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/nav_search"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keep"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/keep"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/history"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/nav_history"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/push"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/push"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setting"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/nav_setting"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/net"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_tv_cinema_nav_focused"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_net_wifi" />
    </LinearLayout>

    <!-- 分类标签栏 -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/recycler_type"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="78dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="28dp"
        android:visibility="gone"
        app:focusOutEnd="false"
        app:focusOutFront="false" />

    <!-- Hero 区域 -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="132dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="3dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_tv_cinema_left_line" />

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#ffff7d9c"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/timeReminder"
            android:layout_width="520dp"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:textColor="#ffff7d9c"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/siteIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="520dp"
                android:layout_height="match_parent"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:shadowColor="#99ffffff"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/appTitleLogo"
                android:layout_width="520dp"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/actor"
            android:layout_width="520dp"
            android:layout_height="28dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#ffd8e6ff"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tip"
            android:layout_width="520dp"
            android:layout_height="76dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="@string/home_tip"
            android:textColor="#ffd8e6ff"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 海报行 -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/posters"
        android:layout_width="match_parent"
        android:layout_height="252dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="-12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="28dp"
        app:focusOutEnd="false"
        app:focusOutFront="false" />

    <!-- 加载中 -->
    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="140dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:indeterminate="true"
            style="?android:progressBarStyleSmall" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_loading"
            android:textColor="@color/white_70"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 内容列表 -->
    <com.fongmi.android.tv.ui.custom.ProgressLayout
        android:id="@+id/progressLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />
    </com.fongmi.android.tv.ui.custom.ProgressLayout>

</FrameLayout>
